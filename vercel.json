{
  "crons": [
    {
      "path": "/api/cron/expire-pending-bookings",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/birthday-vouchers",
      "schedule": "15 7 * * *"
    },
    {
      "path": "/api/cron/engagement",
      "schedule": "30 8 * * *"
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "wild-hearts-collective.vercel.app"
        }
      ],
      "destination": "https://www.wildheartscollective.org/:path*",
      "permanent": true
    }
  ]
}
