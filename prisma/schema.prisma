generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Class {
  id          String    @id @default(cuid())
  slug        String    @unique
  title       String
  description String
  duration    Int       @default(60)
  maxCapacity Int       @default(12)
  /** Optional drop-in override in pence; null uses studio default pricing. */
  pricePence  Int?
  /** Class credits charged when paying with a pack (supports fractions e.g. 1.5). */
  creditCost  Float     @default(1)
  sessions    Session[]
  createdAt   DateTime  @default(now())
}

model Tutor {
  id        String    @id @default(cuid())
  name      String
  email     String?
  phone     String?
  active    Boolean   @default(true)
  bio       String?
  sessions  Session[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([active])
}

/** Studio staff accounts for /admin (master / director / employee). */
model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  /** master | director | employee */
  role         String   @default("employee")
  /**
   * When null, role default permissions apply.
   * When set, this list replaces the role template (except master always has all).
   */
  permissions  Json?
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([role])
  @@index([active])
}

model Session {
  id                String          @id @default(cuid())
  classId           String
  class             Class           @relation(fields: [classId], references: [id], onDelete: Cascade)
  tutorId           String?
  tutor             Tutor?          @relation(fields: [tutorId], references: [id], onDelete: SetNull)
  startsAt          DateTime
  endsAt            DateTime?
  capacity          Int             @default(12)
  status            String          @default("scheduled")
  /** Private studio notes — not shown on the public booking page. */
  adminNotes        String?
  /** Optional public label override (e.g. "Flow"); blank uses class title. */
  displayTitle      String?
  /** Public blurb shown on the booking schedule for this session. */
  publicDescription String?
  /** Optional price override in pence; null falls back to class then studio default. */
  pricePence        Int?
  /** Optional credit cost override; null falls back to class creditCost. */
  creditCost        Float?
  /** Shared id for a 4-week course block (all weekly sessions in the block). */
  courseSeriesId    String?
  /** Week number within the course block (1–4). */
  courseWeek        Int?
  bookings          Booking[]
  waitlist          WaitlistEntry[]
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([startsAt])
  @@index([classId])
  @@index([tutorId])
  @@index([status])
  @@index([courseSeriesId])
}

model User {
  id                           String               @id @default(cuid())
  email                        String
  passwordHash                 String?
  name                         String
  phone                        String?
  image                        String?
  emailVerifiedAt              DateTime?
  phoneVerifiedAt              DateTime?
  dateOfBirth                  DateTime?
  emergencyContactName         String?
  emergencyContactRelationship String?
  emergencyContactPhone        String?
  medicalNotes                 String?
  injuriesLimitations          String?
  allergiesSafetyAlerts        String?
  safetyConsentAt              DateTime?
  parQCompletedAt              DateTime?
  parQData                     Json?
  experienceLevel              String?
  disciplineInterests          String?
  notificationPreferences      String?
  stripeCustomerId             String?              @unique
  membershipPlan               String               @default("account")
  membershipStatus             String               @default("active")
  accountStatus                String               @default("active")
  stripeSubscriptionId         String?              @unique
  membershipStartedAt          DateTime?
  membershipRenewsAt           DateTime?
  membershipPausedAt           DateTime?
  membershipResumeAt           DateTime?
  membershipCancelledAt        DateTime?
  cancellationReason           String?
  creditsRemaining             Float                @default(0)
  totalClassesAttended         Int                  @default(0)
  lastClassAttendedAt          DateTime?
  milestonesAwarded            Json?
  internalNotes                String?
  /** adult | child */
  memberType                   String               @default("adult")
  guardianUserId               String?
  guardian                     User?                @relation("HouseholdMembers", fields: [guardianUserId], references: [id], onDelete: Restrict)
  householdMembers             User[]               @relation("HouseholdMembers")
  parentalConsentAt            DateTime?
  parentalConsentName          String?
  parentalConsentRelationship  String?
  parentalConsentVersion       String?
  createdAt                    DateTime             @default(now())
  updatedAt                    DateTime             @updatedAt
  bookings                     Booking[]
  waitlist                     WaitlistEntry[]
  oauthAccounts                OAuthAccount[]
  verificationCodes            VerificationCode[]
  membershipEvents             MembershipEvent[]
  auditLogs                    AdminAuditLog[]      @relation("AuditTarget")
  classPackPurchases           ClassPackPurchase[]
  creditTransactions           CreditTransaction[]
  vouchers                     Voucher[]
  parQResponse                 ParQResponse?
  engagementLogs               EngagementLog[]
  classFeedbacks               ClassFeedback[]
  idDocuments                  GuardianIdDocument[]

  @@index([email])
  @@index([guardianUserId])
  @@index([memberType])
  @@index([membershipStatus])
  @@index([accountStatus])
  @@index([experienceLevel])
  @@index([dateOfBirth])
  @@index([lastClassAttendedAt])
}

/** Parent/guardian photo ID stored privately for child-member consent. */
model GuardianIdDocument {
  id                String    @id @default(cuid())
  childUserId       String
  child             User      @relation(fields: [childUserId], references: [id], onDelete: Cascade)
  fileName          String
  mimeType          String
  data              Bytes
  uploadedAt        DateTime  @default(now())
  /** pending | approved | rejected */
  status            String    @default("pending")
  reviewedAt        DateTime?
  reviewedByAdminId String?
  reviewNote        String?

  @@index([childUserId])
  @@index([status])
}

model OAuthAccount {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider          String
  providerAccountId String
  profileImageUrl   String?
  createdAt         DateTime @default(now())

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model VerificationCode {
  id        String    @id @default(cuid())
  userId    String?
  user      User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  email     String?
  phone     String?
  codeHash  String
  purpose   String
  channel   String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([email, purpose])
  @@index([userId, purpose])
}

model MembershipEvent {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        String
  note        String?
  effectiveAt DateTime
  endsAt      DateTime?
  createdBy   String    @default("member")
  createdAt   DateTime  @default(now())

  @@index([userId, effectiveAt])
}

model AdminAuditLog {
  id           String   @id @default(cuid())
  action       String
  targetUserId String?
  targetUser   User?    @relation("AuditTarget", fields: [targetUserId], references: [id], onDelete: SetNull)
  adminLabel   String   @default("admin")
  details      String?
  createdAt    DateTime @default(now())

  @@index([targetUserId])
  @@index([createdAt])
}

model ClassPack {
  id          String              @id @default(cuid())
  slug        String              @unique
  name        String
  description String?
  /** Pack credit volume (supports fractions e.g. 5.5). */
  credits     Float
  pricePence  Int
  validDays   Int                 @default(90)
  active      Boolean             @default(true)
  sortOrder   Int                 @default(0)
  createdAt   DateTime            @default(now())
  purchases   ClassPackPurchase[]
}

model StudioSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model ClassPackPurchase {
  id                 String              @id @default(cuid())
  userId             String
  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  packId             String
  pack               ClassPack           @relation(fields: [packId], references: [id], onDelete: Restrict)
  creditsGranted     Float
  creditsRemaining   Float
  expiresAt          DateTime
  stripeSessionId    String?             @unique
  stripePaymentId    String?
  status             String              @default("active")
  giftCardId         String?
  giftCard           GiftCard?           @relation(fields: [giftCardId], references: [id], onDelete: SetNull)
  giftAmountApplied  Int?
  createdAt          DateTime            @default(now())
  bookings           Booking[]
  creditTransactions CreditTransaction[]
  giftRedemptions    GiftCardRedemption[]

  @@index([userId])
  @@index([status])
  @@index([expiresAt])
  @@index([giftCardId])
}

model CreditTransaction {
  id           String             @id @default(cuid())
  userId       String
  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  purchaseId   String?
  purchase     ClassPackPurchase? @relation(fields: [purchaseId], references: [id], onDelete: SetNull)
  bookingId    String?
  booking      Booking?           @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  amount       Float
  balanceAfter Float
  reason       String
  createdAt    DateTime           @default(now())

  @@index([userId, createdAt])
  @@index([bookingId])
}

model Voucher {
  id              String    @id @default(cuid())
  code            String    @unique
  userId          String?
  user            User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  type            String
  discountPercent Int       @default(100)
  expiresAt       DateTime
  usedAt          DateTime?
  bookingId       String?   @unique
  booking         Booking?  @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  metadata        Json?
  createdAt       DateTime  @default(now())

  @@index([userId])
  @@index([type])
  @@index([expiresAt])
}

/**
 * Shop checkout ledger — one row per paid Stripe session.
 * Covers gift vouchers today and physical / other catalog items later.
 */
model ShopOrder {
  id               String          @id @default(cuid())
  stripeSessionId  String          @unique
  status           String          @default("paid")
  /** e.g. shop_voucher | shop_product */
  sourceType       String          @default("shop_voucher")
  purchaserEmail   String?
  purchaserName    String?
  totalPence       Int
  currency         String          @default("gbp")
  /** collection | delivery — only set when order includes physical items */
  fulfillmentMethod String?
  /** Parcel fee charged at checkout (0 for collection / digital-only). */
  shippingPence    Int             @default(0)
  /** Sum of physical item weights × qty used for the parcel fee. */
  totalWeightGrams Int?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  items            ShopOrderItem[]

  @@index([createdAt])
  @@index([purchaserEmail])
  @@index([status])
}

model ShopOrderItem {
  id               String       @id @default(cuid())
  orderId          String
  order            ShopOrder    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId        String?
  product          ShopProduct? @relation(fields: [productId], references: [id], onDelete: SetNull)
  productName      String
  productSlug      String?
  category         String?
  quantity         Int       @default(1)
  unitPricePence   Int
  lineTotalPence   Int
  /** gift_card | physical | digital */
  fulfillmentType  String    @default("gift_card")
  giftCardId       String?
  createdAt        DateTime  @default(now())

  @@index([orderId])
  @@index([productId])
  @@index([giftCardId])
}

/** Client-managed shop catalog — editable in admin. */
model ShopProduct {
  id              String           @id @default(cuid())
  slug            String           @unique
  name            String
  description     String
  category        String
  pricePence      Int
  isAvailable     Boolean          @default(false)
  digitalDelivery Boolean          @default(false)
  /**
   * For digital gift vouchers: "any" (default) or a class slug such as
   * "beginner-courses" so issued codes only redeem on matching bookings.
   */
  giftRedeemScope String?
  /** Packed weight in grams for UK parcel fee (physical items only). */
  weightGrams     Int?
  image           String
  imageGradient   String           @default("from-pink-soft via-cream to-sage-light")
  variants        Json?
  sortOrder       Int              @default(0)
  isArchived      Boolean          @default(false)
  /** When true, stockQuantity is enforced and decremented on sale. */
  trackStock      Boolean          @default(false)
  stockQuantity   Int              @default(0)
  lowStockThreshold Int            @default(5)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  orderItems      ShopOrderItem[]

  @@index([category])
  @@index([isAvailable, isArchived])
  @@index([sortOrder])
  @@index([createdAt])
}

/** Monetised shop e-gift cards with a remaining balance in pence. */
model GiftCard {
  id                  String              @id @default(cuid())
  code                String              @unique
  initialBalancePence Int
  balancePence        Int
  productId           String?
  productName         String
  /**
   * "any" = classes / packs; class slug (e.g. "beginner-courses") =
   * redeemable only when booking that class type.
   */
  redeemScope         String              @default("any")
  purchaserEmail      String?
  purchaserName       String?
  stripeSessionId     String?
  expiresAt           DateTime?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  redemptions         GiftCardRedemption[]
  bookings            Booking[]
  packPurchases       ClassPackPurchase[]

  @@index([stripeSessionId])
  @@index([balancePence])
  @@index([expiresAt])
  @@index([redeemScope])
}

model GiftCardRedemption {
  id             String            @id @default(cuid())
  giftCardId     String
  giftCard       GiftCard          @relation(fields: [giftCardId], references: [id], onDelete: Cascade)
  amountPence    Int
  balanceAfter   Int
  reason         String
  bookingId      String?
  booking        Booking?          @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  packPurchaseId String?
  packPurchase   ClassPackPurchase? @relation(fields: [packPurchaseId], references: [id], onDelete: SetNull)
  userId         String?
  createdAt      DateTime          @default(now())

  @@index([giftCardId, createdAt])
  @@index([bookingId])
  @@index([packPurchaseId])
}

model ParQResponse {
  id          String   @id @default(cuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  data        Json
  submittedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model EngagementLog {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  status    String    @default("pending")
  metadata  Json?
  sentAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, type])
  @@index([status, createdAt])
}

/** Post-class feedback invites (first-lesson check-in and future reviews). */
model ClassFeedback {
  id              String    @id @default(cuid())
  token           String    @unique @default(cuid())
  bookingId       String?   @unique
  booking         Booking?  @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  userId          String?
  user            User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  email           String
  name            String
  classTitle      String?
  sessionStartsAt DateTime?
  rating          Int?
  comments        String?
  shareOnWebsite  Boolean   @default(false)
  submittedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([email])
  @@index([submittedAt])
  @@index([shareOnWebsite, submittedAt])
}

model Booking {
  id               String              @id @default(cuid())
  sessionId        String
  session          Session             @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  userId           String?
  user             User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  name             String
  email            String
  phone            String?
  notes            String?
  status           String              @default("pending")
  attendance       String?
  cancellationType String?
  paidWithCredit   Boolean             @default(false)
  /** Credits deducted for this booking (for accurate refunds when cost ≠ 1). */
  creditsCharged   Float?
  packPurchaseId   String?
  packPurchase     ClassPackPurchase?  @relation(fields: [packPurchaseId], references: [id], onDelete: SetNull)
  voucherId        String?
  voucher          Voucher?
  giftCardId       String?
  giftCard         GiftCard?           @relation(fields: [giftCardId], references: [id], onDelete: SetNull)
  giftAmountApplied Int?
  stripeSessionId  String?             @unique
  stripePaymentId  String?
  amountPaid       Int?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @default(now()) @updatedAt
  creditTransactions CreditTransaction[]
  giftRedemptions  GiftCardRedemption[]
  classFeedback    ClassFeedback?

  @@index([sessionId])
  @@index([email])
  @@index([userId])
  @@index([status])
  @@index([attendance])
  @@index([giftCardId])
}

model WaitlistEntry {
  id        String   @id @default(cuid())
  sessionId String
  session   Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  name      String
  email     String
  phone     String?
  notes     String?
  status    String   @default("waiting")
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([sessionId])
  @@index([email])
  @@index([userId])
  @@index([status])
}
